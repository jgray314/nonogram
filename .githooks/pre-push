#!/bin/sh
# Runs the same steps CI runs, in CI's order, so a red CI run is a local
# failure first, plus the feature-list integrity check. About 3s. Bypass is
# `git push --no-verify` and should be said out loud when used.
set -e
cd "$(git rev-parse --show-toplevel)"
echo "pre-push: feature list"
python scripts/features.py check
echo "pre-push: npm test"
npm test --silent
echo "pre-push: npm run lint"
npm run lint --silent
echo "pre-push: npm run format:check"
npm run format:check --silent
